    "Bubbletea Model": {
        "scope": "go",
        "body": [
            "import tea \"charm.land/bubbletea/v2\"",
            "",
            "type $1Model struct {",
            "\twidth  int",
            "\theight int",
            "}",
            "",
            "func New$1Model($0) $1Model {",
            "\treturn $1Model{}",
            "}",
            "",
            "func (m $1Model) Init() tea.Cmd {",
            "\treturn nil",
            "}",
            "",
            "func (m $1Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {",
            "\tvar cmds []tea.Cmd",
            "\tswitch msg := msg.(type) {",
            "\tcase tea.WindowSizeMsg:",
            "\t\tm.width = msg.Width",
            "\t\tm.height = msg.Height",
            "\tcase tea.KeyPressMsg:",
            "\t\tswitch msg.String() {",
            "\t\t}",
            "\t}",
            "",
            "\treturn m, tea.Batch(cmds...)",
            "}",
            "",
            "func (m $1Model) View() tea.View {",
            "\tvar content string = \"$1Model\"",
            "\tvar view = tea.NewView(content)",
            "\treturn view",
            "}",
            "",
        ]
    }
}